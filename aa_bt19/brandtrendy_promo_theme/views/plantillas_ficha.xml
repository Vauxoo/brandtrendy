<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Ficha de producto, Mi cotización y página 404 del sitio en modo cotización.
        Regla de todas las herencias: lo nuevo lleva t-if="website.bt_quote_mode"; lo que se oculta del original lleva
        t-if="not website.bt_quote_mode" como atributo (el nodo y su texto traducido se quedan en la vista de origen).
        Ningún nodo con texto traducible se reemplaza: el sitio 1 rinde exactamente lo mismo.
        Anclas verificadas contra el arch combinado de Odoo 19 (ver comentario de cada plantilla); ninguna es
        t-set, t-call ni t-foreach.
    -->

    <!--
        Ficha · precio. Ancla: span.oe_price de website_sale.product_price (templates.xml 19.0). El JavaScript de
        variantes solo reescribe .oe_price .oe_currency_value, así que «Desde» y «IVA incluido» sobreviven al cambio
        de variante. Los precios del sitio incluyen IVA (impuesto con price_include y
        show_line_subtotals_tax_selection = tax_included en el sitio).
    -->
    <template id="ficha_precio_desde" inherit_id="website_sale.product_price"
              name="Promocionales · precio «Desde $X · IVA incluido»">
        <xpath expr="//span[hasclass('oe_price')]" position="before">
            <span t-if="website.bt_quote_mode" class="bt_precio_desde">Desde</span>
        </xpath>
        <xpath expr="//span[hasclass('oe_price')]" position="after">
            <span t-if="website.bt_quote_mode" class="bt_precio_iva">· IVA incluido</span>
        </xpath>
    </template>

    <!--
        Ficha · bloque de compra y orden en móvil. Anclas en el arch combinado de website_sale.product:
        - div.o_wsale_product_details_content_section_price: mínimo y aviso de envío junto al precio.
        - div.o_wsale_product_details_content_section_cta: expectativa del CTA junto a «Agregar a cotización».
        - div#product_attributes_simple: después va la descripción larga (con sus preguntas frecuentes), que en este
          sitio sale del bloque del título; así precio, variantes, cantidad y botón quedan antes en móvil.
        - fila tr de product_attributes_simple: «Cantidad mínima» (atributo de catálogo de la 17) ya se muestra junto
          al precio con x_bt_moq; se omite la fila solo si el producto tiene x_bt_moq.
        - li de la ruta de navegación: se omite la raíz del árbol de categorías cuando no es la última
          («Productos» ya enlaza al catálogo). La ruta sale de la primera categoría pública del producto (la de menor
          secuencia): las transversales («Por industria», «Por ocasión») van con secuencia ≥30000 en el catálogo.
    -->
    <template id="ficha_bloque_compra" inherit_id="website_sale.product"
              name="Promocionales · bloque de compra de la ficha">
        <xpath expr="//div[hasclass('o_wsale_product_details_content_section_price')]" position="inside">
            <t t-if="website.bt_quote_mode">
                <p t-if="product.x_bt_moq" class="bt_ficha_minimo mb-1">
                    <t t-if="product.x_bt_moq == 1">Desde 1 pieza</t>
                    <t t-else="">Desde <t t-out="product.x_bt_moq" t-options="{'widget': 'integer'}"/> piezas</t>
                </p>
                <p class="bt_ficha_aparte mb-0">El envío y la personalización se cotizan aparte.</p>
            </t>
        </xpath>
        <xpath expr="//div[hasclass('o_wsale_product_details_content_section_cta')]" position="inside">
            <p t-if="website.bt_quote_mode" class="bt_ficha_expectativa mb-0">En 1 día hábil recibes tu cotización formal, con precio, personalización y plazo de entrega confirmados por un ejecutivo.</p>
        </xpath>
        <xpath expr="//div[@id='product_attributes_simple']//tr" position="attributes">
            <attribute name="t-if">not (website.bt_quote_mode and product.x_bt_moq and attribute.name == 'Cantidad mínima')</attribute>
        </xpath>
        <xpath expr="//div[@id='product_attributes_simple']" position="after">
            <div t-if="website.bt_quote_mode" id="bt_ficha_descripcion"
                 class="o_wsale_product_details_content_section bt_ficha_descripcion mb-4">
                <div t-field="product.description_ecommerce" class="oe_structure text-muted"
                     placeholder="Descripción del producto"/>
            </div>
        </xpath>
        <xpath expr="//ol[hasclass('o_wsale_breadcrumb')]//li[a[contains(@t-att-href, 'slug(cat)')] and not(hasclass('d-lg-none'))]" position="attributes">
            <attribute name="t-if">not (website.bt_quote_mode and not cat.parent_id and not cat_last)</attribute>
        </xpath>
        <!-- Raíz de la ruta: «Productos», igual que en el listado (el li original y su texto traducido se quedan). -->
        <xpath expr="//ol[hasclass('o_wsale_breadcrumb')]/li[a[@t-att-href='keep(shop_path)']]" position="attributes">
            <attribute name="t-if">not website.bt_quote_mode</attribute>
        </xpath>
        <xpath expr="//ol[hasclass('o_wsale_breadcrumb')]/li[a[@t-att-href='keep(shop_path)']]" position="before">
            <li t-if="website.bt_quote_mode" class="breadcrumb-item d-none d-lg-inline-block"><a t-att-href="keep(shop_path)">Productos</a></li>
        </xpath>
    </template>

    <!--
        Ficha · bloque del título. Ancla: div[@t-field='product.description_ecommerce'] de website_sale.product_title.
        Si se puede agregar a cotización, la descripción se muestra en #bt_ficha_descripcion (después del bloque de
        compra); si no, se queda aquí.
    -->
    <template id="ficha_descripcion_despues" inherit_id="website_sale.product_title"
              name="Promocionales · descripción después del bloque de compra">
        <xpath expr="//div[@t-field='product.description_ecommerce']" position="attributes">
            <attribute name="t-if">not (website.bt_quote_mode and is_add_to_cart_possible)</attribute>
        </xpath>
        <!--
            H1 del producto: el modelo BT-XXX-0000 (con su «– » previo) no se corta en dos renglones. Ancla:
            h1[@t-field='product.name']; en este sitio se rinde un H1 gemelo (mismas clases) con el modelo en
            text-nowrap. El nombre es dato de catálogo y no se edita desde la ficha; si no trae « BT-», sale tal cual.
        -->
        <xpath expr="//h1[@t-field='product.name']" position="attributes">
            <attribute name="t-if">not website.bt_quote_mode</attribute>
        </xpath>
        <xpath expr="//h1[@t-field='product.name']" position="after">
            <h1 t-if="website.bt_quote_mode" t-attf-class="h3 {{'mb-3' if not product.description_ecommerce and not is_view_active('website_sale.product_comment') else ''}}">
                <t t-set="bt_nombre" t-value="product.name or ''"/>
                <t t-set="bt_corte" t-value="bt_nombre.rfind(' BT-')"/>
                <t t-if="bt_corte &gt; 0">
                    <t t-set="bt_cabeza" t-value="bt_nombre[:bt_corte]"/>
                    <t t-set="bt_modelo" t-value="bt_nombre[bt_corte + 1:]"/>
                    <t t-if="bt_cabeza.endswith(' –') or bt_cabeza.endswith(' -')">
                        <t t-set="bt_modelo" t-value="bt_cabeza[-1:] + ' ' + bt_modelo"/>
                        <t t-set="bt_cabeza" t-value="bt_cabeza[:-2]"/>
                    </t>
                    <t t-out="bt_cabeza"/> <span class="text-nowrap" t-out="bt_modelo"/>
                </t>
                <t t-else="" t-out="bt_nombre"/>
            </h1>
        </xpath>
    </template>

    <!-- Ficha · cantidad con nombre accesible. Ancla: input[@name='add_qty'] de website_sale.product_quantity. -->
    <template id="ficha_cantidad_etiqueta" inherit_id="website_sale.product_quantity"
              name="Promocionales · nombre accesible de la cantidad">
        <xpath expr="//input[@name='add_qty']" position="attributes">
            <attribute name="t-att-aria-label">'Cantidad' if website.bt_quote_mode else None</attribute>
        </xpath>
    </template>

    <!-- Ficha · botón «Agregar a cotización» sin ícono de carrito. Ancla: a#add_to_cart/i de website_sale.cta_wrapper. -->
    <template id="ficha_boton_sin_carrito" inherit_id="website_sale.cta_wrapper"
              name="Promocionales · botón de cotización sin carrito">
        <xpath expr="//a[@id='add_to_cart']/i" position="attributes">
            <attribute name="t-if">not website.bt_quote_mode</attribute>
        </xpath>
    </template>

    <!--
        Cabeza del documento (website.layout). Anclas:
        - script[@t-out='product_markup_data'] (website_sale.website_sale_layout): JSON-LD del producto. En este sitio
          no se afirma existencia: «availability» (InStock/OutOfStock, de website_sale_stock) se sustituye por
          itemCondition NewCondition; «All Products» es una cadena fija en Python (controllers/main.py,
          _prepare_breadcrumb_markup_data), no un término traducible. json.dumps(json.loads(…)) valida el JSON y
          devuelve el objeto seguro para <script>.
        - meta[@name='default_description'] y link[@rel='canonical']: en la 404 sin og/twitter (el título saldría del
          nombre de la vista «Page Not Found») y sin canonical hacia la URL inexistente.
    -->
    <template id="cabeza_ficha_y_404" inherit_id="website.layout"
              name="Promocionales · JSON-LD de producto y cabeza de la 404">
        <xpath expr="//script[@t-out='product_markup_data']" position="attributes">
            <attribute name="t-out">json.dumps(json.loads(str(product_markup_data).replace('"availability": "https://schema.org/InStock"', '"itemCondition": "https://schema.org/NewCondition"').replace('"availability": "https://schema.org/OutOfStock"', '"itemCondition": "https://schema.org/NewCondition"').replace('"name": "All Products"', '"name": "Todos los productos"')), indent=2) if website.bt_quote_mode else product_markup_data</attribute>
        </xpath>
        <xpath expr="//meta[@name='default_description']" position="after">
            <t t-if="website.bt_quote_mode and status_code == 404" t-set="website_meta" t-value="{}"/>
        </xpath>
        <xpath expr="//link[@rel='canonical']" position="attributes">
            <attribute name="t-if">not (website.bt_quote_mode and status_code == 404)</attribute>
        </xpath>
    </template>

    <!--
        Mi cotización (/shop/cart). Anclas en website_sale.cart: div#shop_cart (el título del documento va antes, dentro
        del t-call), div#shop_cart/div con el h4 del resumen y su div del botón «Repetir solicitud» (sin cuentas de
        cliente en este sitio: solo si hay historial). website_meta_title de la vista («Mi cotización», TI2) queda
        para el sitio 1.
    -->
    <template id="cotizacion_encabezado" inherit_id="website_sale.cart"
              name="Promocionales · encabezado de Mi cotización">
        <!-- Hijo directo del t-call: el título llega a la cabeza del documento (website.layout). -->
        <xpath expr="//div[@id='shop_cart']" position="before">
            <t t-if="website.bt_quote_mode" t-set="title" t-value="'Mi cotización | ' + website.name"/>
        </xpath>
        <!-- «Resumen de tu solicitud» solo cuando hay líneas. -->
        <xpath expr="//div[@id='shop_cart']/div[h4]" position="attributes">
            <attribute name="t-if">not website.bt_quote_mode or (website_sale_order and website_sale_order.website_order_line)</attribute>
        </xpath>
        <xpath expr="//div[@id='shop_cart']/div[h4]" position="before">
            <h1 t-if="website.bt_quote_mode" class="bt_cotizacion_titulo mb-3">Mi cotización</h1>
        </xpath>
        <xpath expr="//div[@id='shop_cart']/div[h4]/div[hasclass('border-start')]" position="attributes">
            <attribute name="t-if">not website.bt_quote_mode or order_history</attribute>
        </xpath>
    </template>

    <!--
        Mi cotización vacía. Ancla: primer div.js_cart_lines de website_sale.cart_lines (estado vacío): sin la
        ilustración del carrito y con la explicación del proceso.
    -->
    <template id="cotizacion_vacia" inherit_id="website_sale.cart_lines"
              name="Promocionales · Mi cotización vacía">
        <xpath expr="//div[hasclass('js_cart_lines')]/div[hasclass('mt-5')]" position="attributes">
            <attribute name="t-if">not website.bt_quote_mode</attribute>
        </xpath>
        <xpath expr="//div[hasclass('js_cart_lines')][div[hasclass('mt-5')]]/h5" position="after">
            <p t-if="website.bt_quote_mode" class="bt_cotizacion_vacia">Agrega los modelos que te interesan desde el catálogo y envía tu solicitud. En 1 día hábil recibes tu cotización formal, con precio, personalización y plazo de entrega confirmados por un ejecutivo.</p>
        </xpath>
    </template>

    <!--
        404. Ancla: section[@data-snippet='s_image_text'] de http_routing.404. En este sitio se oculta completa (con lo
        que le agregue cualquier otra herencia) y se muestra una composición tipográfica con una sola acción
        («Ver el catálogo»), el buscador de productos de la cabecera (D6) y el correo para reportar el enlace.
        Prioridad 30: se aplica después de las herencias del sitio con prioridad menor.
    -->
    <template id="pagina_no_encontrada" inherit_id="http_routing.404" priority="30"
              name="Promocionales · página no encontrada">
        <!-- Hijo directo del t-call: el título llega a la cabeza del documento (website.layout). -->
        <xpath expr="//div[@id='wrap']" position="before">
            <t t-if="website.bt_quote_mode" t-set="additional_title">Página no encontrada</t>
        </xpath>
        <xpath expr="//section[@data-snippet='s_image_text']" position="attributes">
            <attribute name="t-if">not website.bt_quote_mode</attribute>
        </xpath>
        <xpath expr="//section[@data-snippet='s_image_text']" position="before">
            <t t-if="website.bt_quote_mode">
                <section class="bt_404 py-5">
                    <div class="container">
                        <div class="row justify-content-center">
                            <div class="col-lg-8 text-center py-lg-5">
                                <h1 class="mb-3">Página no encontrada</h1>
                                <p class="mb-4">No encontramos la página que buscas. Busca el producto por nombre o
                                    modelo, o entra al catálogo.</p>
                                <t t-call="website.website_search_box_input"
                                   _form_classes.f="bt_404_buscador mx-auto mb-4"
                                   _input_classes.f="rounded-start-pill ps-3 text-bg-light"
                                   _submit_classes.f="rounded-end-pill p-3 bg-o-color-3 lh-1"
                                   search_type.f="products_only"
                                   action.f="/shop"
                                   placeholder.f="Buscar modelo o producto"
                                   limit.f="5"
                                   display_image.f="true"
                                   display_description.f="false"
                                   display_extra_link.f="false"
                                   display_detail.f="true"/>
                                <p class="mb-4"><a href="/shop" class="btn btn-primary">Ver el catálogo</a></p>
                                <p class="bt_404_ayuda mb-0">Si crees que es un error, escríbenos a
                                    <a href="mailto:hola@brandtrendy.com.mx">hola@brandtrendy.com.mx</a>.</p>
                            </div>
                        </div>
                    </div>
                </section>
            </t>
        </xpath>
    </template>
</odoo>
