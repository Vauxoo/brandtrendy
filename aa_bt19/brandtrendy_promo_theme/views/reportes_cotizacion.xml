<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        PDF de cotización del equipo Promocionales y carta membretada.

        En la 17 vivían como registros sueltos de la base (vistas brandtrendy_f4.bt_external_layout,
        brandtrendy_f4.bt_report_saleorder_document y brandtrendy_f4.bt_carta_membretada; reportes «Cotización ·
        Promocionales» y «Carta membretada BT»; formato «BT Carta Cotización»). Aquí quedan como plantillas,
        formato y reportes del módulo. El paso «reportes» de website._bt_promo_aplicar quita los de la 17 del menú
        Imprimir y archiva sus vistas; no borra nada.

        Cambios contra la 17:
        · line.product_uom → line.product_uom_id (en 19 el campo cambió de nombre; con el anterior el PDF fallaba en
          toda orden del equipo).
        · Las subsecciones de 19 (display_type line_subsection) se pintan como sección y no como producto vacío.
        · El equipo ya no va por id: el formato aplica a las órdenes del equipo de ventas de un sitio en modo cotización.
        · El RFC del pie sale de la empresa del documento; los estilos ya no se cargan desde un adjunto por URL
          (static/src/scss/reporte_cotizacion.scss va en web.report_assets_common).
    -->

    <record id="paperformat_bt_carta" model="report.paperformat">
        <field name="name">Promocionales · carta</field>
        <field name="format">Letter</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">36</field>
        <field name="margin_bottom">26</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">34</field>
        <field name="dpi">96</field>
    </record>

    <!-- Membrete: lockup Promocionales arriba, pie fiscal con numeración. -->
    <template id="bt_external_layout" name="Promocionales · membrete de reportes">
        <t t-set="bt_empresa" t-value="(o and 'company_id' in o and o.company_id) or res_company"/>
        <div class="header bt-header">
            <table class="bt-head-table"><tr>
                <td class="bt-head-left">
                    <div class="bt-lockup">
                        <img src="data:image/png;base64," alt="BRANDTRENDY" class="bt-logo"/>
                        <div class="bt-descriptor-row"><span class="bt-descriptor">Promocionales</span></div>
                    </div>
                    <div t-if="o and o._name == 'account.move'" class="bt-razon-social">BRANDTRENDY, S.A. DE C.V.</div>
                </td>
                <td class="bt-head-right"/>
            </tr></table>
            <div class="bt-rule"/>
        </div>
        <div class="article o_report_layout_bt" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id"
             t-att-data-oe-lang="o and o.env.context.get('lang')">
            <t t-out="0"/>
        </div>
        <div class="footer bt-footer">
            <div class="bt-footer-rule"/>
            <table class="bt-footer-table"><tr>
                <td class="bt-footer-fiscal">
                    BRANDTRENDY, S.A. DE C.V.<t t-if="bt_empresa.vat"> | RFC: <t t-out="bt_empresa.vat"/></t><br/>
                    Calle Poniente 134, No. 682, Bodega E, Col. Industrial Vallejo, Alcaldía Azcapotzalco, C.P. 02300, Ciudad de México<br/>
                    <span class="bt-nowrap">Tel. y WhatsApp: +52 55 5526 0418</span> |
                    <t t-if="o and o._name == 'account.move'">facturacion@brandtrendy.com.mx</t>
                    <t t-else="">ventas@brandtrendy.com.mx</t>
                    | promocionales.brandtrendy.com.mx
                </td>
                <td class="bt-footer-page">Página <span class="page"/> de <span class="topage"/></td>
            </tr></table>
        </div>
    </template>

    <!-- Cotización con membrete. Solo para órdenes del equipo de un sitio en modo cotización; las demás reciben un aviso. -->
    <template id="bt_report_saleorder_document" name="Cotización · Promocionales">
        <t t-call="web.html_container">
            <t t-set="bt_equipos" t-value="env['website'].sudo().search([('bt_quote_mode', '=', True)]).salesteam_id"/>
            <t t-foreach="docs" t-as="o">
                <!-- div.article: sin él wkhtmltopdf recibe el aviso sin charset y los acentos salen rotos -->
                <div t-if="not (o.team_id &amp; bt_equipos)" class="article" t-att-data-oe-model="o._name" t-att-data-oe-id="o.id">
                    <div class="page" style="font-family:sans-serif;padding:40px">
                        <p style="font-size:12pt;line-height:1.6">
                            <b>Formato exclusivo de Brandtrendy Promocionales.</b><br/>
                            La orden <span t-field="o.name"/> no pertenece al equipo Promocionales, así que este
                            documento no se imprime con su membrete ni con sus condiciones comerciales.<br/>
                            Usa el reporte «PDF Quote» para esta orden.
                        </p>
                    </div>
                </div>
                <t t-else="" t-call="brandtrendy_promo_theme.bt_external_layout">
                    <t t-set="doc" t-value="o.with_context(lang=o.partner_id.lang)"/>
                    <div class="page bt-page">
                        <table class="bt-doc-title"><tr><td class="bt-title-left">
                            <div class="bt-h1">Cotización</div>
                            <div class="bt-folio" t-field="doc.name"/>
                        </td></tr></table>
                        <table class="bt-meta"><tr>
                            <td class="bt-meta-cliente">
                                <div class="bt-lbl">Cliente</div>
                                <div class="bt-strong" t-out="doc.partner_id.commercial_company_name or doc.partner_id.name"/>
                                <div t-if="doc.partner_id.commercial_company_name and doc.partner_id.name != doc.partner_id.commercial_company_name">Atención: <span t-field="doc.partner_id.name"/></div>
                                <div><span t-field="doc.partner_id.email"/> · <span t-field="doc.partner_id.phone"/></div>
                            </td>
                            <td class="bt-meta-datos"><table>
                                <tr>
                                    <td style="padding-right:16px"><div class="bt-lbl">Fecha de emisión</div><div t-field="doc.date_order" t-options="{&quot;widget&quot;: &quot;date&quot;}"/></td>
                                    <td><div class="bt-lbl">Vigente hasta</div><div class="bt-strong" t-field="doc.validity_date" t-options="{&quot;widget&quot;: &quot;date&quot;}"/><div class="bt-small">7 días naturales</div></td>
                                </tr>
                                <tr>
                                    <td class="bt-meta-pad" style="padding-right:16px"><div class="bt-lbl">Condiciones de pago</div><div>70% anticipo · 30% antes de liberar</div></td>
                                    <td class="bt-meta-pad"><div class="bt-lbl">Moneda</div><div><span t-field="doc.currency_id.name"/> — pesos mexicanos</div></td>
                                </tr>
                            </table></td>
                        </tr></table>
                        <table class="bt-lines">
                            <thead><tr>
                                <th class="bt-th bt-th-concepto">Concepto</th>
                                <th class="bt-th bt-num">Cantidad</th>
                                <th class="bt-th bt-num">Precio unitario (IVA incluido)</th>
                                <th class="bt-th bt-num">Importe (IVA incluido)</th>
                            </tr></thead>
                            <tbody>
                                <t t-foreach="doc.order_line" t-as="line">
                                    <tr t-if="line.display_type in ('line_section', 'line_subsection')" class="bt-row-section"><td colspan="4"><span t-field="line.name"/></td></tr>
                                    <tr t-elif="line.display_type == 'line_note'" class="bt-row-note"><td colspan="4"><span t-field="line.name"/></td></tr>
                                    <tr t-else="" class="bt-row">
                                        <td class="bt-cell-concepto">
                                            <div class="bt-strong" t-out="line.product_id.display_name or line.name"/>
                                            <t t-set="bt_desc" t-value="line.name.split('\n', 1)[1].strip() if line.name and '\n' in line.name else ('' if not line.name or (line.product_id and line.name == line.product_id.display_name) else line.name)"/>
                                            <div class="bt-desc" t-if="bt_desc" t-out="bt_desc"/>
                                        </td>
                                        <td class="bt-cell bt-num"><span t-field="line.product_uom_qty"/> <span t-field="line.product_uom_id.name"/></td>
                                        <td class="bt-cell bt-num"><span t-field="line.price_unit" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.currency_id}"/></td>
                                        <td class="bt-cell bt-num bt-strong"><span t-field="line.price_total" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.currency_id}"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                        <table class="bt-totales"><tr>
                            <td class="bt-totales-nota">Precios en pesos mexicanos. El total incluye IVA. Cantidades sujetas a múltiplos de caja cerrada. Precios especiales por volumen — solicita cotización.</td>
                            <td class="bt-totales-tabla"><table>
                                <tr><td>Suma de importes (IVA incluido)</td><td class="bt-num"><span t-field="doc.amount_total" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.currency_id}"/></td></tr>
                                <tr><td>Base gravable</td><td class="bt-num"><span t-field="doc.amount_untaxed" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.currency_id}"/></td></tr>
                                <tr><td>IVA (16%)</td><td class="bt-num"><span t-field="doc.amount_tax" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.currency_id}"/></td></tr>
                                <tr class="bt-total-final"><td>Total a pagar</td><td class="bt-num"><span t-field="doc.amount_total" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.currency_id}"/> MXN</td></tr>
                            </table></td>
                        </tr></table>
                        <table class="bt-condiciones"><tr>
                            <td>
                                <div class="bt-lbl">Condiciones</div>
                                <div class="bt-cond-text">Vigencia de 7 días naturales a partir de la fecha de emisión.<br/>Pago: 70% de anticipo para iniciar y 30% antes de liberar. Único método de pago: transferencia electrónica interbancaria; los datos bancarios se comparten al confirmar el pedido.<br/>La producción inicia con anticipo confirmado, archivos utilizables y prueba digital aprobada.</div>
                            </td>
                            <td>
                                <div class="bt-lbl">Personalización</div>
                                <div class="bt-cond-text">Prueba digital incluida; 1 ronda de cambios sin costo.<br/>Los tiempos de producción corren a partir de la confirmación completa; el tránsito del envío es adicional.<br/>Los colores se igualan como referencia; variaciones razonables de tono no constituyen defecto.</div>
                            </td>
                        </tr></table>
                        <div class="bt-atencion">
                            <span class="bt-strong">¿Dudas sobre esta cotización?</span>
                            <span> Atendido por <span t-field="doc.user_id.name"/> · ventas@brandtrendy.com.mx · <span class="bt-nowrap">Tel. y WhatsApp +52 55 5526 0418</span></span>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- Hoja membretada en blanco para documentos del equipo (se imprime desde el contacto). -->
    <template id="bt_carta_membretada" name="Promocionales · carta membretada">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="brandtrendy_promo_theme.bt_external_layout">
                    <div class="page bt-page bt-carta">
                        <div class="bt-carta-fecha">Ciudad de México, a <span t-out="time.strftime('%d/%m/%Y')"/></div>
                        <div class="bt-carta-dest">
                            <div style="font-weight:700;color:#231F20;" t-field="o.name"/>
                            <div t-if="o.commercial_company_name and o.name != o.commercial_company_name" t-field="o.commercial_company_name"/>
                            <div t-if="o.email" t-field="o.email"/>
                        </div>
                        <div class="bt-carta-asunto">Asunto: [asunto del documento]</div>
                        <div class="bt-carta-cuerpo">
                            <p>Estimado(a) [nombre]:</p>
                            <p>[Cuerpo de la carta. Esta plantilla valida la hoja membretada: encabezado con lockup Promocionales, pie fiscal de tres líneas con numeración de página y márgenes de 18 mm por lado. El contenido se sustituye al emitir cada documento.]</p>
                            <p>Sin más por el momento, quedamos a sus órdenes.</p>
                        </div>
                        <div class="bt-carta-firma">
                            <div class="bt-firma-linea"/>
                            <div style="font-weight:700;color:#231F20;">[Nombre del firmante]</div>
                            <div style="font-size:8.5pt;color:#5F5E61;">[Cargo] · [correo]@brandtrendy.com.mx</div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="accion_reporte_cotizacion" model="ir.actions.report">
        <field name="name">Cotización · Promocionales</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">brandtrendy_promo_theme.bt_report_saleorder_document</field>
        <field name="report_file">brandtrendy_promo_theme.bt_report_saleorder_document</field>
        <field name="paperformat_id" ref="paperformat_bt_carta"/>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
    </record>

    <record id="accion_reporte_carta" model="ir.actions.report">
        <field name="name">Carta membretada BT</field>
        <field name="model">res.partner</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">brandtrendy_promo_theme.bt_carta_membretada</field>
        <field name="report_file">brandtrendy_promo_theme.bt_carta_membretada</field>
        <field name="paperformat_id" ref="paperformat_bt_carta"/>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_type">report</field>
    </record>

    <!--
        PDF estándar de cotización (PDF Quote y los que heredan del documento: Quotation/Order, Pro-Forma) para las
        órdenes de un sitio en modo cotización. Sustituye a la vista brandtrendy_f4.bt_report_saleorder_ws2 de la 17,
        que en 19 ya no valida (su ancla //div[hasclass('page')]/h2 desapareció: el título ahora lo pinta el membrete).
        Las órdenes de los demás sitios y de ventas directas quedan intactas.
        · 13 título y total en tinta #231F20 (se acota al artículo de la orden; el h2 de 19 está fuera de div.page).
        · 8 la línea de envío sin precio dice «—» y «Por cotizar», nunca $0.00.
        · 6 términos y condiciones en el dominio del sitio (se conserva el nodo order_note para la vista de delivery).
        · 7 fuera «Términos de pago: pago inmediato»; en su lugar, cotización sin costo y sin compromiso.
        Anclas (odoo 19.0 addons/sale/report/sale_report_templates.xml, report_saleorder_document): t-set
        display_discount, td td_product_name, td_product_priceunit, td_product_subtotal, span order_note y el p de
        doc.payment_term_id.note.
    -->
    <template id="reporte_cotizacion_sitio" inherit_id="sale.report_saleorder_document" priority="99"
              name="Promocionales · PDF de cotización del sitio">
        <xpath expr="//t[@t-set='display_discount']" position="after">
            <t t-set="bt_cotizacion_sitio" t-value="bool(doc.website_id.bt_quote_mode)"/>
            <t t-set="bt_productos_envio" t-value="doc.env['delivery.carrier'].sudo().search([('website_id', '=', doc.website_id.id)]).product_id.ids if bt_cotizacion_sitio else []"/>
            <style t-if="bt_cotizacion_sitio">
                .article[data-oe-model="sale.order"][data-oe-id="<t t-out="doc.id"/>"] h2,
                .article[data-oe-model="sale.order"][data-oe-id="<t t-out="doc.id"/>"] .h2,
                .article[data-oe-model="sale.order"][data-oe-id="<t t-out="doc.id"/>"] #total strong,
                .article[data-oe-model="sale.order"][data-oe-id="<t t-out="doc.id"/>"] .totals_taxes_company_currency strong { color: #231F20 !important; }
            </style>
        </xpath>
        <xpath expr="//td[@name='td_product_name']" position="before">
            <t t-set="bt_envio_por_cotizar" t-value="bt_cotizacion_sitio and (line.is_delivery or line.product_id.id in bt_productos_envio) and not line.price_unit and not line.price_subtotal"/>
        </xpath>
        <xpath expr="//td[@name='td_product_priceunit']/span[@t-field='line.price_unit']" position="attributes">
            <attribute name="t-elif">not collapse_prices and not bt_envio_por_cotizar</attribute>
        </xpath>
        <xpath expr="//td[@name='td_product_priceunit']/span[@t-field='line.price_unit']" position="after">
            <span t-elif="bt_envio_por_cotizar" class="text-muted">—</span>
        </xpath>
        <xpath expr="//td[@name='td_product_subtotal']/t" position="attributes">
            <attribute name="t-if">not line.is_downpayment and not collapse_prices and not bt_envio_por_cotizar</attribute>
        </xpath>
        <xpath expr="//td[@name='td_product_subtotal']/t" position="after">
            <span t-if="bt_envio_por_cotizar" class="text-muted text-nowrap">Por cotizar</span>
        </xpath>
        <xpath expr="//span[@name='order_note']" position="attributes">
            <attribute name="t-if">not bt_cotizacion_sitio</attribute>
        </xpath>
        <xpath expr="//span[@name='order_note']" position="after">
            <p t-if="bt_cotizacion_sitio" name="order_note_bt" class="mt-3">
                Términos y condiciones:
                <a href="https://promocionales.brandtrendy.com.mx/terminos-y-condiciones">https://promocionales.brandtrendy.com.mx/terminos-y-condiciones</a>
            </p>
        </xpath>
        <xpath expr="//p[span[@t-field='doc.payment_term_id.note']]" position="attributes">
            <attribute name="t-if">not is_html_empty(doc.payment_term_id.note) and not bt_cotizacion_sitio</attribute>
        </xpath>
        <xpath expr="//p[span[@t-field='doc.payment_term_id.note']]" position="after">
            <p t-if="bt_cotizacion_sitio" name="bt_quote_terms" class="mt-2">
                Cotización sin costo y sin compromiso: no se requiere ningún pago en línea. Las condiciones de pago se
                confirman en la cotización formal que te envía tu asesor.
            </p>
        </xpath>
    </template>
</odoo>
